# Conexão com o Postgres (em produção/Neon, usar a connection string "pooled").
# Nunca commite valores reais; use apenas exemplos fictícios aqui.
DATABASE_URL=postgresql://usuario_ficticio:senha_ficticia@localhost:5432/lab_invisivel

# URL base pública para montagem dos links de sala (opcional; se ausente,
# deriva da requisição).
# NEXT_PUBLIC_APP_URL=https://exemplo.ficticio

# Segredo da rotina de limpeza de salas expiradas (/api/cron/cleanup).
# Obrigatório em produção; sem ele a rotina fica desabilitada (503).
# CLEANUP_SECRET=
